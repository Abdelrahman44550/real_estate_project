<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tenant List View (Tree) -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="phone"/>
                <field name="city"/>
            </tree>
        </field>
    </record>


    <!-- Tenant Form View -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">

            <form string="Tenant">
                <header>
                <button name="update_notes" string="Update Notes" type="object" class="oe_highlight"/>
                <button name="get_lead" string="Get Lead Name" type="object" class="oe_highlight"/>
                </header>
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant's Name"/>
                        </h1>
                    </div>

                    <group string="Tenant Data">

                        <group>
                            <field name="city"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="crm_id"/>
                        </group>
                        <group>
                            <field name="date_joined"/>
                            <field name="date_of_birth"/>
                            <field name="age_category"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>
            </form>

        </field>
    </record>


    <!-- Tenant Action -->
    <record id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenant</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tenant
            </p>
        </field>
    </record>
        <!-- Tenant Search View -->
    <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
               <group expand="0" string="Group By">
                    <filter string="Age" name="age_category" context="{'group_by': 'age_category'}"/>
                </group>             
            </search>
        </field>
    </record>
    <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="date_joined"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Joined: <field name="date_joined"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Tenant Menu -->
    <menuitem
        id="menu_tenant"
        name="Tenants"
        action="action_tenant"/>

</odoo>