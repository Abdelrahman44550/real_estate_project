<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Lease List View (Tree) -->
    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <tree string="Leases">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="deposit_paid"/>
                <field name="property_id"/>
            </tree>
        </field>
    </record>
        <!--    Lease Form View -->
    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">

            <form string="Lease">
            <header>
                <field name="state" widget="statusbar" ></field>
                <button name="convert_to_active" string="Active" type="object" invisible="state == 'active'" class="oe_highlight"/>
                <button name="convert_to_draft" string="Draft" type="object" invisible="state == 'draft'" class="oe_highlight"/>
                <button name="make_maintainance_request" string="Make Maintainance Request" type="object" class="oe_highlight"/>
                <button name="%(real_estate.action_maintenance_request_wizard)d" string="Maintenance Request" type="action" context="{'default_lease_id': active_id}" invisible="state != 'active'"/>
            </header> 
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lease's ID"/>
                        </h1>
                    </div>
       

                    <group string="Lease Data">

                        <group>
                            <field name="name"/>
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                            <field name="user_id"/>
                            <field name="deposit_paid"/>
                            <field name="total_cost"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="monthly_rent"/>
                            <field name="duration_months"/>
                            <field name="is_active"/>
                            <field name="electricity_recharge"/>
                        </group>

                    </group>
                     <notebook>

                        <page string="Maintainances">
                            <field name="maintainances_ids">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="assigned_to"/>
                                    <!-- <field name="property_id "/> -->
                                </tree>
                            </field>                                
                        </page>
                    </notebook>



                </sheet>
            </form>

        </field>
    </record>
    <!-- Lease Action (Links views together) -->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease
            </p>
        </field>
    </record>
        <!-- Lease Search View -->
    <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <search string="Search Lease">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>

                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"  />
               <group expand="0" string="Group By">
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                </group>    
                <separator/>
         
            </search>
        </field>
    </record>
    <!-- Lease Kanban View -->
    <record id="view_lease_kanban" model="ir.ui.view">
        <field name="name">real_estate.lease.kanban</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="end_date" widget="end_date"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Joined: <field name="start_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>    