<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tenant_wizard_form" model="ir.ui.view">
        <field name="name">tenant.wizard.form</field>
        <field name="model">tenant.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Tenant">
                <group>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <group>
                        <field name="city"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_tanent" string="Submit Request" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tenant_wizard" model="ir.actions.act_window">
        <field name="name">Create Tenant</field>
        <field name="res_model">tenant.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
