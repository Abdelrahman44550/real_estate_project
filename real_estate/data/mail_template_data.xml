<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="email_template_payment_upcoming" model="mail.template">
            <field name="name">Lease: Upcoming Payment Reminder</field>
            <field name="model_id" ref="real_estate.model_real_estate_lease"/>
            <field name="subject">Upcoming Rent Payment for {{ object.property_id.name }}</field>
            <field name="email_from">{{ (object.property_id.agent_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.tenant_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.tenant_id.name"/>,<br/><br/>
                        This is a friendly reminder that your rent payment for <strong><t t-out="object.property_id.name"/></strong> 
                        is due on <strong><t t-out="object.next_payment_date"/></strong>.<br/><br/>
                        Amount Due: <strong><t t-out="object.monthly_rent"/></strong><br/><br/>
                        Please ensure the payment is made by the due date to avoid any late fees.<br/><br/>
                        Best regards,<br/>
                        <t t-out="object.property_id.agent_id.name or 'Real Estate Management'"/>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
        <record id="email_template_maintenance_reminder" model="mail.template">
            <field name="name">Maintenance: Upcoming Request Reminder</field>

            <field name="model_id" ref="real_estate.model_maintenance_request"/>

            <field name="subject">
                Maintenance Reminder - {{ object.property_id.name }}
            </field>

            <field name="email_from">
                {{ user.email_formatted }}
            </field>

            <field name="email_to">
                {{ object.assigned_to.email }}
            </field>

            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">

                        Dear <t t-out="object.assigned_to.name"/>,<br/><br/>

                        This is a reminder that you have a maintenance request
                        scheduled for tomorrow so be ready.<br/><br/>

                        <strong>Property:</strong>
                        <t t-out="object.property_id.name"/><br/>

                        <strong>Lease:</strong>
                        <t t-out="object.lease_id.name"/><br/>

                        <strong>Tenant:</strong>
                        <t t-out="object.tenant_id.name"/><br/>

                        <strong>Maintenance Date:</strong>
                        <t t-out="object.preferred_date"/><br/>

                        <strong>Issue Type:</strong>
                        <t t-out="object.issue_type"/><br/>

                        <strong>Description:</strong>
                        <t t-out="object.description"/><br/><br/>

                        Please make sure to handle the maintenance request
                        on the scheduled date.<br/><br/>

                        Best regards,<br/>
                        Real Estate Management

                    </p>
                </div>
            </field>

            <field name="auto_delete" eval="True"/>
        </record>
</odoo>